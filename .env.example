# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# Supabase Postgres connection string: Supabase dashboard > Connect > Session pooler.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Project URL, used to check sign-in tokens against the project's public
# signing keys (no secret needed): Supabase dashboard > Project Settings > Data API.
SUPABASE_URL=https://<project-ref>.supabase.co

# Optional: browser origins allowed to call the API, comma-separated
# (default http://localhost:3000). In production: the frontend's Vercel URL.
# ALLOWED_ORIGINS=http://localhost:3000

# Optional usage limits (backend/limits.py). Days and months are in Europe/Oslo.
# Global budget for all users together, in USD (the Anthropic Console's hard
# limit is 10 USD a month; the app stops earlier):
# GLOBAL_BUDGET_USD_PER_MONTH=9
# GLOBAL_BUDGET_USD_PER_DAY=1
# Per user: coach messages in the last 60 minutes, and tokens (input + output) a day:
# CHAT_MESSAGES_PER_HOUR=30
# CHAT_TOKENS_PER_DAY=50000
# Optional: a "Support the app" link shown when the monthly budget is used up.
# SUPPORT_URL=

# Optional: a database (ideally a separate dev project) for tests/test_db.py.
# TEST_DATABASE_URL=
