  "known_bad": {
    "source": "Written for this case: the coach treats a one-line change as a replan and calls it done.",
    "why": "Says the run is already moved and the plan rebuilt, although nothing changes until Accept.",
    "should_fail": "must_not-1",
    "answer": "Done! I've moved Thursday's run to Friday and rebuilt the rest of your plan around it."
  },
  "question": "Something came up at work. Can you move Thursday's run next week to Friday?",
  "expect": {
    "tools_called": [
      "get_plan",
      "propose_plan_change"
    ],
    "tools_not_called": [
      "propose_program"
    ],
    "change_types": [
      "move"
    ],
    "tool_inputs": {
      "propose_plan_change": {
        "changes": [
          {
            "type": "move",
            "planned_id": 2,
            "date": "{monday+4}"
          }
        ],
        "reason": "Friday works better with your week."
      }
    },
    "must": [
      "Say that moving next week's Thursday run to Friday is proposed and that the user accepts it in the app (nothing changes before that)"
    ],
    "must_not": [
      "Say or imply the run has already been moved, or the plan changed or saved",
      "Propose a new plan, or any change besides moving that one run",
      "Change or question the user's goal"
    ]
  }
